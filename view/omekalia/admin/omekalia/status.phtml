<?= $this->pageTitle($this->translate('Omekalia status')) ?>

<table id="system-info-table">
    <colgroup>
        <col class="label-col">
        <col class="value-col">
    </colgroup>
    <tbody>
        <tr>
            <th scope="rowgroup" colspan="2">Omekalia <?= $this->omekalia()->getModule('Omekalia')->getIni('version') ?></th>
        </tr>
        <tr>
            <th scope="row">Omeka S</th>
            <?php $ok = $omekaliaData['omeka']['version'] === \Omeka\Module::VERSION; ?>
            <td class="<?= $ok ? '' : 'warning' ?>">
                <?= $ok ? '✓' : '✗' ?>
                <?= \Omeka\Module::VERSION ?>
                <?php if (!$ok): ?>
                    (<?= $this->translate('expected:') ?> <?= $this->escapeHtml($omekaliaData['omeka']['version']) ?>)
                <?php endif; ?>
            </td>
        </tr>
    </tbody>

    <tbody>
        <tr>
            <th scope="rowgroup" colspan="2"><?= $this->translate('Modules') ?></th>
        </tr>
        <?php foreach ($omekaliaData['modules'] as $moduleData): ?>
            <?php $module = $this->omekalia()->getModule($moduleData['name']); ?>
            <?php $ok = $module && $module->getIni('version') === $moduleData['version'] ?>
            <tr>
                <th scope="row"><?= $this->escapeHtml($moduleData['name']) ?></th>
                <td class="<?= $ok ? '' : 'warning' ?>">
                    <?= $ok ? '✓' : '✗' ?>
                    <?= $module ? $module->getIni('version') : $this->translate('not installed') ?>
                    <?php if (!$ok): ?>
                        (<?= $this->translate('expected:') ?> <?= $this->escapeHtml($moduleData['version']) ?>)
                    <?php endif; ?>
                </td>
            </tr>
        <?php endforeach; ?>
    </tbody>

    <tbody>
        <tr>
            <th scope="rowgroup" colspan="2"><?= $this->translate('Themes') ?></th>
        </tr>
        <?php foreach ($omekaliaData['themes'] as $themeData): ?>
            <?php $theme = $this->omekalia()->getTheme($themeData['name']); ?>
            <?php $ok = $theme && $theme->getIni('version') === $themeData['version'] ?>
            <tr>
                <th scope="row"><?= $this->escapeHtml($themeData['name']) ?></th>
                <td class="<?= $ok ? '' : 'warning' ?>">
                    <?= $ok ? '✓' : '✗' ?>
                    <?= $theme ? $theme->getIni('version') : $this->translate('not installed') ?>
                    <?php if (!$ok): ?>
                        (<?= $this->translate('expected:') ?> <?= $this->escapeHtml($themeData['version']) ?>)
                    <?php endif; ?>
                </td>
            </tr>
        <?php endforeach; ?>
    </tbody>

    <tbody>
        <tr>
            <th scope="rowgroup" colspan="2"><?= $this->translate('Other') ?></th>
        </tr>
        <tr>
            <th scope="row"><?= $this->escapeHtml($this->translate('Other active modules')) ?></th>
            <td>
                <?php if (!empty($otherActiveModules)): ?>
                    <?= implode(', ', array_map(fn($m) => $m->getId(), $otherActiveModules)) ?>
                <?php else: ?>
                    <?= $this->translate('No other inactive modules') ?>
                <?php endif; ?>
            </td>
        </tr>
        <tr>
            <th scope="row"><?= $this->escapeHtml($this->translate('Other inactive modules')) ?></th>
            <td>
                <?php if (!empty($otherInactiveModules)): ?>
                    <?= implode(', ', array_map(fn($m) => $m->getId(), $otherInactiveModules)) ?>
                <?php else: ?>
                    <?= $this->translate('No other inactive modules') ?>
                <?php endif; ?>
            </td>
        </tr>
        <tr>
            <th scope="row"><?= $this->escapeHtml($this->translate('Other themes')) ?></th>
            <td>
                <?php if (!empty($otherThemes)): ?>
                    <?= implode(', ', array_map(fn($t) => $t->getId(), $otherThemes)) ?>
                <?php else: ?>
                    <?= $this->translate('No other themes') ?>
                <?php endif; ?>
            </td>
        </tr>
    </tbody>
</table>
